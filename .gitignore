# Raw DMS tables are large (tens of MB each) and live outside version control.
data/raw/*
!data/raw/.gitkeep

# Structures are fetched or predicted, not authored here.
data/structures/*
!data/structures/.gitkeep

# Pipeline outputs are regenerated by `make all`.
results/*
!results/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
build/
dist/
